          "selector": "section.appt-section",
          "style": "highlight",
          "blocks": [],
          "defaultContent": [
            ".appointment-bar .during-hours"
          ]
        },
        {
          "id": "section-8",
          "name": "Help EndCancer",
          "selector": "section.highlight.apply",
          "style": "highlight",
          "blocks": [
            "cards"
          ],
          "defaultContent": [
            ".nested-section-title h2"
          ]
