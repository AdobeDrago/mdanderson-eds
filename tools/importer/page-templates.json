            ".col-content h1",
            ".col-content h2",
            ".col-content h3",
            ".col-content p",
            ".col-content ul"
          ]
        },
        {
          "id": "section-2",
          "name": "Schedule Mammogram Promo",
          "selector": ".promo.promo-simple.promo-icon-red",
          "style": null,
          "blocks": [
            "cards"
          ],
          "defaultContent": []
        },
        {
          "id": "section-3",
          "name": "Video Embeds",
          "selector": [
            ".cell-s.last .media-player.media-single-small"
          ],
          "style": null,
          "blocks": [
            "embed"
          ],
          "defaultContent": []
        },
        {
          "id": "section-4",
          "name": "Infographic and Related Articles",
          "selector": [
            ".cell-s.last .blog-summary.small"
          ],
          "style": null,
          "blocks": [
            "cards"
          ],
          "defaultContent": [
            ".cell-s.last .cq-dd-image"
